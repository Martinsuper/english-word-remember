{
  "expo": {
    "name": "考研英语闪卡",
    "slug": "kaoyan-flashcards",
    "scheme": "kaoyanflashcards",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.duanluyao.kaoyanflashcards"
    },
    "android": {
      "package": "com.duanluyao.kaoyanflashcards",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101418"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-sqlite",
      "expo-font"
    ]
  }
}
